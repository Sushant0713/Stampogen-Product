NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME=Stampogen
# App host (login, admin, /join/{slug} QR) — defaults to https://app.stampogen.in if unset
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Marketing site (Home, About, Affiliate) — defaults to https://stampogen.in if unset
NEXT_PUBLIC_MARKETING_URL=https://stampogen.in
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id
BACKEND_URL=http://localhost:5000
