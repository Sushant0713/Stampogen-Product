# Copy to repo root as `.env.docker` before `docker compose up`
#   cp deploy/docker.env.example .env.docker

NODE_ENV=production

# Public site URL (also used when building frontend — set in shell or .env next to compose)
# NEXT_PUBLIC_APP_URL=https://stampogen.example.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# STAMPOGEN_HTTP_PORT=3081
# STAMPOGEN_HTTP_BIND=127.0.0.1

JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=365d
JWT_REFRESH_EXPIRES_IN=3650d

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://stampogen.example.com/api/v1/auth/google/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Stampogen <noreply@stampogen.example.com>

OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

FRONTEND_URL=https://stampogen.example.com
CORS_ORIGIN=https://stampogen.example.com

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=100
